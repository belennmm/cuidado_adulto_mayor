APP_NAME="Cuidado Adulto Mayor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
SANCTUM_EXPIRATION=60
HASH_DRIVER=argon2id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
SECURITY_AUDIT_INTEGRITY_KEY=
SECURITY_AUDIT_KEY_ID=v1
SECURITY_AUDIT_COLLECTOR_URL=
SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_SESSION_CACHE_STORE=file
SECURITY_AUDIT_EVENTS_PER_MINUTE=500
SECURITY_AUDIT_URGENT_PER_MINUTE=100
SECURITY_AUDIT_RECORD_BYTES=8192
SECURITY_AUDIT_DAILY_BYTES=52428800
SECURITY_ALERT_WINDOW_SECONDS=60
SECURITY_ALERT_COOLDOWN_SECONDS=300
SECURITY_ALERT_BRUTE_FORCE=10
SECURITY_ALERT_DENIALS=10
SECURITY_ALERT_MASS_ACCESS=100

DB_CONNECTION=pgsql
DB_URL=
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
# Dedicated runtime account; use a separate account for migrations.
DB_USERNAME=cuidado_runtime
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_IDLE_TIMEOUT=15
SESSION_ABSOLUTE_TIMEOUT=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
CORS_ALLOWED_ORIGINS=https://example.com
MAX_REQUEST_BYTES=2097152

# Comprueba nuevas contrasenas con prefijos anonimos; no envia contrasenas.
PASSWORD_CHECK_COMPROMISED=true

# URL del frontend fija; en produccion HTTPS y correo SMTP (no log/array).
PASSWORD_RESET_URL=https://example.com/pages/reset-password.html
# Opcionales solo para seeders local/testing; vacios generan claves aleatorias.
DEMO_SEED_PASSWORD=
SECURITY_SCAN_ADMIN_PASSWORD=
SECURITY_SCAN_PROFESSIONAL_PASSWORD=
SECURITY_SCAN_FAMILY_PASSWORD=
PERFORMANCE_SEED_PASSWORD=

SESSION_MAX_PER_USER=5
SESSION_REAUTHENTICATION_TIMEOUT=5
